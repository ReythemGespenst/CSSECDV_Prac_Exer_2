<html>
<head>
	<link rel="stylesheet" type="text/css" href="/styles.css">
</head>
<body>
<p>Welcome, admin <p style="color:green;"><%= username %></p></p>
<h2>Manage Users</h2>
<form action="/admin/update-roles" method="POST">
	<table>
		<thead>
		<tr>
			<th>Username</th>
			<th>Email</th>
			<th>Roles</th>
		</tr>
		</thead>
		<tbody>
		<% usersWithRoles.forEach(({ user, roles }) => { %>
			<tr>
				<td><%= user.username %></td>
				<td><%= user.email %></td>
				<td>
					<input type="hidden" name="users[<%= user._id %>][userId]" value="<%= user._id %>">
					<% ['user', 'admin', 'manager'].forEach(role => { %>
						<label>
							<input
									type="checkbox"
									name="users[<%= user._id %>][roleIds][]"
									value="<%= role %>"
									<%= roles && roles.includes(role) ? 'checked' : '' %>>
							<%= role %>
						</label>
					<% }) %>
				</td>
			</tr>
		<% }) %>
		</tbody>
	</table>
	<button type="submit">Update Roles</button>
</form>
</body>
</html>