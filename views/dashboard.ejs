<!DOCTYPE html>
<html>
<head>
	<link rel="stylesheet" type="text/css" href="/styles.css">
	<title>Dashboard</title>
	<style>
		table {
			width: 60%;
			margin-top: 20px;
			border-collapse: collapse;
		}
		th, td {
			padding: 10px;
			border: 1px solid #ccc;
			text-align: left;
		}
		th {
			background-color: #f2f2f2;
		}
	</style>
</head>
<body>
	<p>Welcome, user <p style="color:green;"><%= username %></p></p>

	<!-- Logout Form -->
	<form action="/post/signout" method="POST">
		<input type="submit" value="Logout">
	</form>

	<!-- Quick Links Table -->
	<h2>Quick Links</h2>
	<table>
		<thead>
			<tr>
				<th>Route</th>
				<th>Access</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td><a href="/users">/users</a></td>
				<td>Admin, Manager</td>
			</tr>
			<tr>
				<td><a href="/admin">/admin</a></td>
				<td>Admin only</td>
			</tr>
			<tr>
				<td><a href="/profile">/profile</a></td>
				<td>Users with "edit profile" permission</td>
			</tr>
			<tr>
				<td><a href="/delete">/delete</a></td>
				<td>Admin only</td>
			</tr>
		</tbody>
	</table>
</body>
</html>
